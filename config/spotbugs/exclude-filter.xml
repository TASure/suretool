<?xml version="1.0" encoding="UTF-8"?>
<!--
  suretool SpotBugs 排除清单：
  仅排除「设计意图 / 惯例性」告警，真实缺陷一律修复而非排除。
  新增排除项必须在注释中说明理由。
-->
<FindBugsFilter>

    <!-- 构造器参数校验抛异常（CT_CONSTRUCTOR_THROW）：
         suretool 工具类均为 final 不可继承、无 finalize 方法，不存在 Finalizer 攻击面；
         Hutool 等主流工具库同样在构造器直接校验参数。 -->
    <Match>
        <Bug pattern="CT_CONSTRUCTOR_THROW"/>
    </Match>

    <!-- 反射元数据共享（EI_EXPOSE_REP / EI_EXPOSE_REP2）：
         PropDesc 持有的 Field/Method 为 JDK 反射对象（全局单例语义，无防御性拷贝可行做法），
         与 Hutool BeanDesc 等实现一致，属行业惯例。 -->
    <Match>
        <Class name="com.sure.tool.bean.PropDesc"/>
        <Bug pattern="EI_EXPOSE_REP,EI_EXPOSE_REP2"/>
    </Match>

    <!-- Boolean 包装类型显式返回 null（NP_BOOLEAN_RETURN_NULL）：
         API 语义刻意设计——缺失值返回 null（区别于 false），调用方按三态处理；
         与 Hutool JSONObject.getBool / Dict.getBool 行为一致。 -->
    <Match>
        <Bug pattern="NP_BOOLEAN_RETURN_NULL"/>
    </Match>

    <!-- 持锁 sleep（SWL_SLEEP_WITH_LOCK_HELD）：
         Snowflake 时钟回拨等待时持 synchronized 锁是有意设计，保证同毫秒内 ID 全局唯一。 -->
    <Match>
        <Bug pattern="SWL_SLEEP_WITH_LOCK_HELD"/>
    </Match>

    <!-- 反射提升字段可访问性（REFLF_REFLECTION_MAY_INCREASE_ACCESSIBILITY_OF_FIELD）：
         反射工具库的本职能力（getField 返回私有字段供调用方读写），非缺陷。 -->
    <Match>
        <Bug pattern="REFLF_REFLECTION_MAY_INCREASE_ACCESSIBILITY_OF_FIELD"/>
    </Match>

    <!-- JWT 的 header/payload 返回可变 JSON 模型（EI_EXPOSE_REP）：
         JSONObject 为工具库自带可变模型，getPayload()/getHeader() 供调用方继续读写 claim，
         与 Hutool JWT.getPayload 行为一致；setKey(byte[]) 已做防御性拷贝，不在此排除。 -->
    <Match>
        <Class name="com.sure.tool.jwt.JWT"/>
        <Bug pattern="EI_EXPOSE_REP"/>
    </Match>

    <!-- SocketClient 暴露/接收底层 Socket（EI_EXPOSE_REP / EI_EXPOSE_REP2）：
         SocketClient 为轻量门面，getSocket() 与构造注入均有意暴露底层 Socket 供
         高级 IO / 自定义操作使用（对齐 Hutool SocketClient 设计）；Socket 为 JDK 标准
         类，无防御性拷贝可行做法，生命周期由 SocketClient.close() 幂等管理。 -->
    <Match>
        <Class name="com.sure.tool.socket.SocketClient"/>
        <Bug pattern="EI_EXPOSE_REP,EI_EXPOSE_REP2"/>
    </Match>

    <!-- EventBus 全局默认实例暴露（MS_EXPOSE_REP）与非私有构造器（SING_SINGLETON_HAS_NONPRIVATE_CONSTRUCTOR）：
         EventBus 采用「全局默认实例 + 独立实例」双模式：getDefault() 返回共享总线供
         快速使用，同时允许 new EventBus() 构造隔离总线（如按模块隔离事件域）；
         可变总线本身就是被使用的对象，无防御性拷贝语义。 -->
    <Match>
        <Class name="com.sure.tool.event.EventBus"/>
        <Bug pattern="MS_EXPOSE_REP,SING_SINGLETON_HAS_NONPRIVATE_CONSTRUCTOR"/>
    </Match>

    <!-- 全局默认数据源存入静态字段（EI_EXPOSE_STATIC_REP2）：
         DbUtil.setDefaultDataSource 为设计意图的全局默认数据源（对齐 Hutool DbUtil.use()），
         DataSource 无防御性拷贝语义；调用方应持有并管理自己的数据源生命周期。 -->
    <Match>
        <Class name="com.sure.tool.db.DbUtil"/>
        <Bug pattern="EI_EXPOSE_STATIC_REP2"/>
    </Match>

    <!-- Result 暴露原始异常（EI_EXPOSE_REP）：
         Result.getCause() 有意返回调用方注入的原始异常，供日志/捕获/包装使用
         （与 fail(Throwable) 传入的是同一对象，非内部共享状态）；异常对象在
         工具库语义中按不可变使用，与 JWT/SocketClient 惯例一致。 -->
    <Match>
        <Class name="com.sure.tool.lang.Result"/>
        <Bug pattern="EI_EXPOSE_REP"/>
    </Match>

</FindBugsFilter>
