<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>io.github.tasure</groupId>
        <artifactId>suretool</artifactId>
        <version>1.19.1</version>
    </parent>

    <artifactId>sure-all</artifactId>
    <packaging>jar</packaging>
    <name>suretool-all</name>
    <description>聚合模块：一个依赖引入全部工具域（等价旧版 suretool 单模块）。</description>

    <properties>
        <japicmp.skip>false</japicmp.skip>
        <!-- 聚合包无源码，不参与 JaCoCo 覆盖率门禁与 SpotBugs 静态扫描 -->
        <jacoco.skip>true</jacoco.skip>
        <spotbugs.skip>true</spotbugs.skip>
    </properties>

    <dependencies>
        <dependency>
            <groupId>io.github.tasure</groupId>
            <artifactId>sure-core</artifactId>
        </dependency>
        <dependency>
            <groupId>io.github.tasure</groupId>
            <artifactId>sure-log</artifactId>
        </dependency>
        <dependency>
            <groupId>io.github.tasure</groupId>
            <artifactId>sure-db</artifactId>
        </dependency>
        <dependency>
            <groupId>io.github.tasure</groupId>
            <artifactId>sure-script</artifactId>
        </dependency>
        <dependency>
            <groupId>io.github.tasure</groupId>
            <artifactId>sure-template</artifactId>
        </dependency>
        <dependency>
            <groupId>io.github.tasure</groupId>
            <artifactId>sure-aop</artifactId>
        </dependency>
        <dependency>
            <groupId>io.github.tasure</groupId>
            <artifactId>sure-pdf</artifactId>
        </dependency>
        <dependency>
            <groupId>io.github.tasure</groupId>
            <artifactId>sure-process</artifactId>
        </dependency>
        <dependency>
            <groupId>io.github.tasure</groupId>
            <artifactId>sure-math</artifactId>
        </dependency>
        <dependency>
            <groupId>io.github.tasure</groupId>
            <artifactId>sure-compress</artifactId>
        </dependency>
        <dependency>
            <groupId>io.github.tasure</groupId>
            <artifactId>sure-socket</artifactId>
        </dependency>
        <dependency>
            <groupId>io.github.tasure</groupId>
            <artifactId>sure-event</artifactId>
        </dependency>
        <dependency>
            <groupId>io.github.tasure</groupId>
            <artifactId>sure-json</artifactId>
        </dependency>
        <dependency>
            <groupId>io.github.tasure</groupId>
            <artifactId>sure-http</artifactId>
        </dependency>
        <dependency>
            <groupId>io.github.tasure</groupId>
            <artifactId>sure-crypto</artifactId>
        </dependency>
        <dependency>
            <groupId>io.github.tasure</groupId>
            <artifactId>sure-cron</artifactId>
        </dependency>
        <dependency>
            <groupId>io.github.tasure</groupId>
            <artifactId>sure-cache</artifactId>
        </dependency>
        <dependency>
            <groupId>io.github.tasure</groupId>
            <artifactId>sure-xml</artifactId>
        </dependency>
        <dependency>
            <groupId>io.github.tasure</groupId>
            <artifactId>sure-poi</artifactId>
        </dependency>
        <dependency>
            <groupId>io.github.tasure</groupId>
            <artifactId>sure-captcha</artifactId>
        </dependency>
        <dependency>
            <groupId>io.github.tasure</groupId>
            <artifactId>sure-jwt</artifactId>
        </dependency>
        <dependency>
            <groupId>io.github.tasure</groupId>
            <artifactId>sure-dfa</artifactId>
        </dependency>
        <dependency>
            <groupId>io.github.tasure</groupId>
            <artifactId>sure-extra</artifactId>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!-- 依赖契约白名单：聚合模块按定义依赖全部工具模块；
                 禁止依赖 BOM / 示例 / 基准 / starter / 自身，防止聚合层反向依赖。 -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-enforcer-plugin</artifactId>
                <configuration>
                    <rules combine.self="override">
                        <bannedDependencies>
                            <searchTransitive>false</searchTransitive>
                            <message>sure-all 只允许依赖各工具模块，禁止依赖 BOM/示例/基准/starter/自身。</message>
                            <excludes>
                                <exclude>io.github.tasure:suretool</exclude>
                                <exclude>io.github.tasure:sure-bom</exclude>
                                <exclude>io.github.tasure:sure-all</exclude>
                                <exclude>io.github.tasure:sure-examples</exclude>
                                <exclude>io.github.tasure:sure-benchmark</exclude>
                                <exclude>io.github.tasure:sure-spring-boot-starter</exclude>
                            </excludes>
                        </bannedDependencies>
                    </rules>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
