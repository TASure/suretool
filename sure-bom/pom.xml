<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.sure</groupId>
        <artifactId>suretool</artifactId>
        <version>0.1.0</version>
    </parent>

    <artifactId>sure-bom</artifactId>
    <packaging>pom</packaging>
    <name>suretool-bom</name>
    <description>BOM（Bill of Materials）：统一管理 suretool 全部模块与配套第三方版本，import 后无需再写版本号。</description>

    <properties>
        <!-- 无源码模块，不参与 JaCoCo 覆盖率门禁与 SpotBugs 静态扫描 -->
        <jacoco.skip>true</jacoco.skip>
        <spotbugs.skip>true</spotbugs.skip>
    </properties>

    <dependencyManagement>
        <dependencies>
            <!-- suretool 全模块（版本统一由 ${project.version} 驱动） -->
            <dependency>
                <groupId>com.sure</groupId>
                <artifactId>sure-core</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.sure</groupId>
                <artifactId>sure-json</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.sure</groupId>
                <artifactId>sure-http</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.sure</groupId>
                <artifactId>sure-crypto</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.sure</groupId>
                <artifactId>sure-cron</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.sure</groupId>
                <artifactId>sure-cache</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.sure</groupId>
                <artifactId>sure-xml</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.sure</groupId>
                <artifactId>sure-poi</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.sure</groupId>
                <artifactId>sure-captcha</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.sure</groupId>
                <artifactId>sure-jwt</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.sure</groupId>
                <artifactId>sure-dfa</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.sure</groupId>
                <artifactId>sure-all</artifactId>
                <version>${project.version}</version>
            </dependency>

            <!-- 配套第三方（与根 pom 版本一致，供 sure-poi 等模块的使用方免写版本） -->
            <dependency>
                <groupId>org.apache.poi</groupId>
                <artifactId>poi-ooxml-full</artifactId>
                <version>${poi.version}</version>
            </dependency>
            <dependency>
                <groupId>org.apache.poi</groupId>
                <artifactId>poi-ooxml</artifactId>
                <version>${poi.version}</version>
            </dependency>
            <dependency>
                <groupId>junit</groupId>
                <artifactId>junit</artifactId>
                <version>${junit.version}</version>
                <scope>test</scope>
            </dependency>
            <dependency>
                <groupId>org.openjdk.jmh</groupId>
                <artifactId>jmh-core</artifactId>
                <version>${jmh.version}</version>
            </dependency>
            <dependency>
                <groupId>org.openjdk.jmh</groupId>
                <artifactId>jmh-generator-annprocess</artifactId>
                <version>${jmh.version}</version>
                <scope>provided</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>
</project>
