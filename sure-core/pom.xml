<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>io.github.tasure</groupId>
        <artifactId>suretool</artifactId>
        <version>1.13.1-SNAPSHOT</version>
    </parent>

    <artifactId>sure-core</artifactId>
    <packaging>jar</packaging>
    <name>suretool-core</name>
    <properties>
        <jacoco.line.min>0.90</jacoco.line.min>
    </properties>
    <description>核心工具域：字符串/集合/日期/IO/Bean/并发/断言等，零第三方运行期依赖。</description>
    <dependencies>
        <dependency>
            <groupId>net.jqwik</groupId>
            <artifactId>jqwik</artifactId>
            <version>${jqwik.version}</version>
            <scope>test</scope>
        </dependency>
    </dependencies>
    <build>
        <plugins>
            <!-- sure-core 双测试框架并存：JUnit4（既有用例）+ JUnit Platform（jqwik 属性测试）；
                 仅本模块启用，避免影响其他纯 JUnit4 模块 -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <dependencies>
                    <dependency>
                        <groupId>org.apache.maven.surefire</groupId>
                        <artifactId>surefire-junit4</artifactId>
                        <version>3.1.2</version>
                    </dependency>
                    <dependency>
                        <groupId>org.apache.maven.surefire</groupId>
                        <artifactId>surefire-junit-platform</artifactId>
                        <version>3.1.2</version>
                    </dependency>
                </dependencies>
            </plugin>
            <!-- japicmp 二进制兼容门禁：对比上一发布版本 v1.8.0，破坏性 API 变更即失败 -->
            <plugin>
                <groupId>com.github.siom79.japicmp</groupId>
                <artifactId>japicmp-maven-plugin</artifactId>
                <version>0.23.1</version>
                <configuration>
                    <oldVersion>
                        <dependency>
                            <groupId>io.github.tasure</groupId>
                            <artifactId>sure-core</artifactId>
                            <version>1.8.0</version>
                        </dependency>
                    </oldVersion>
                    <newVersion>
                        <file>
                            <path>${project.build.directory}/${project.artifactId}-${project.version}.jar</path>
                        </file>
                    </newVersion>
                    <breakOnBinaryIncompatibleModifications>true</breakOnBinaryIncompatibleModifications>
                    <onlyModified>true</onlyModified>
                    <ignoreMissingClasses>true</ignoreMissingClasses>
                </configuration>
                <executions>
                    <execution>
                        <phase>verify</phase>
                        <goals>
                            <goal>cmp</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>