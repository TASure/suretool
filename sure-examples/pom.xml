<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>io.github.tasure</groupId>
        <artifactId>suretool</artifactId>
        <version>0.1.0</version>
    </parent>

    <artifactId>sure-examples</artifactId>
    <packaging>jar</packaging>
    <name>suretool-examples</name>
    <description>suretool 使用示例模块：覆盖全部工具域的可运行 Demo（不参与覆盖率门禁，编译与静态检查保留）。</description>

    <properties>
        <!-- 示例模块无业务可测，不参与 JaCoCo 覆盖率门禁；SpotBugs 对示例代码存在合理误报，一并跳过 -->
        <jacoco.skip>true</jacoco.skip>
        <spotbugs.skip>true</spotbugs.skip>
    </properties>

    <dependencies>
        <dependency>
            <groupId>io.github.tasure</groupId>
            <artifactId>sure-all</artifactId>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!-- 运行聚合入口：mvn -pl sure-examples exec:java -->
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>exec-maven-plugin</artifactId>
                <version>3.6.3</version>
                <configuration>
                    <mainClass>com.sure.tool.example.ExamplesRunner</mainClass>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
