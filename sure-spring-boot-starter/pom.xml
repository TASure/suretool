<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>io.github.tasure</groupId>
        <artifactId>suretool</artifactId>
        <version>1.20.0</version>
    </parent>

    <artifactId>sure-spring-boot-starter</artifactId>
    <packaging>jar</packaging>
    <name>suretool-spring-boot-starter</name>
    <description>suretool Spring Boot Starter：自动装配入口骨架，帮助 Spring Boot 应用零配置接入 suretool 能力。</description>

    <properties>
        <japicmp.skip>false</japicmp.skip>
        <spring-boot.version>4.1.2</spring-boot.version>
        <!-- Starter 无业务测试数据，不参与 JaCoCo 覆盖率门禁；自动配置骨架类跳过 SpotBugs -->
        <jacoco.skip>true</jacoco.skip>
        <spotbugs.skip>true</spotbugs.skip>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-dependencies</artifactId>
                <version>${spring-boot.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>
        <!-- 基础依赖：只引入 core，不再传递 POI / PDFBox / Zxing / commons-compress -->
        <dependency>
            <groupId>io.github.tasure</groupId>
            <artifactId>sure-core</artifactId>
        </dependency>
        <!-- 默认装配的验证码域（默认开启），因此是必选依赖；仅依赖 core，零第三方 -->
        <dependency>
            <groupId>io.github.tasure</groupId>
            <artifactId>sure-captcha</artifactId>
        </dependency>
        <!-- 可选域：optional 依赖不传递给使用方；使用方显式引入对应模块后，
             自动装配类通过 @ConditionalOnClass 生效（未引入时整段配置跳过） -->
        <dependency>
            <groupId>io.github.tasure</groupId>
            <artifactId>sure-event</artifactId>
            <optional>true</optional>
        </dependency>
        <dependency>
            <groupId>io.github.tasure</groupId>
            <artifactId>sure-cron</artifactId>
            <optional>true</optional>
        </dependency>
        <dependency>
            <groupId>io.github.tasure</groupId>
            <artifactId>sure-cache</artifactId>
            <optional>true</optional>
        </dependency>
        <!-- 自动装配（编译期即可，运行时由应用自身引入 starter） -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-autoconfigure</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-configuration-processor</artifactId>
            <optional>true</optional>
        </dependency>
        <!-- 冒烟测试：上下文加载/属性绑定/条件装配（BOM 统一版本） -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>
	<build>
		<plugins>
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-jar-plugin</artifactId>
				<configuration>
					<archive>
						<manifestEntries>
							<Automatic-Module-Name>sure.boot</Automatic-Module-Name>
						</manifestEntries>
					</archive>
				</configuration>
			</plugin>
			<!-- 依赖契约白名单：core + captcha 为必选，event/cron/cache 为 optional 可选域 -->
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-enforcer-plugin</artifactId>
				<configuration>
					<rules combine.self="override">
						<bannedDependencies>
							<searchTransitive>false</searchTransitive>
							<message>sure-spring-boot-starter 只允许依赖 core/captcha 及可选 event/cron/cache，禁止 sure-all。</message>
							<excludes>
								<exclude>io.github.tasure:*</exclude>
							</excludes>
							<includes>
								<include>io.github.tasure:sure-core</include>
								<include>io.github.tasure:sure-captcha</include>
								<include>io.github.tasure:sure-event</include>
								<include>io.github.tasure:sure-cron</include>
								<include>io.github.tasure:sure-cache</include>
							</includes>
						</bannedDependencies>
					</rules>
				</configuration>
			</plugin>
		</plugins>
	</build>
</project>
